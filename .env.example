CAREER_OPS_CN_TOKEN=replace-with-a-local-token
CAREER_OPS_CN_BRIDGE_PORT=3847
CAREER_OPS_CN_EVALUATION_TIMEOUT_MS=120000
CAREER_OPS_CN_PROFILE_VERSION=default-profile-v1
CAREER_OPS_CN_PROMPT_VERSION=career-ops-cn-openai-v1
CAREER_OPS_CN_EVALUATION_SCHEMA_VERSION=1
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 未配置 DEEPSEEK_API_KEY 时，可继续使用已有 OpenAI-compatible 配置：
# OPENAI_API_KEY=replace-with-your-provider-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
