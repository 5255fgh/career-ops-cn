{
  "name": "@career-ops-cn/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --conditions=development --env-file-if-exists=../../.env --import tsx --watch src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/cli.js"
  },
  "dependencies": {
    "@career-ops-cn/career-ops-adapter": "workspace:*",
    "@career-ops-cn/screening": "workspace:*",
    "@career-ops-cn/shared": "workspace:*",
    "fastify": "^5.6.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
