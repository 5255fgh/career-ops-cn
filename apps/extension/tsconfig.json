{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@career-ops-cn/boss-adapter": ["../../packages/boss-adapter/src/index.ts"],
      "@career-ops-cn/shared": ["../../packages/shared/src/index.ts"]
    },
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["entrypoints/**/*.ts", "entrypoints/**/*.tsx", "lib/**/*.ts", "wxt.config.ts"]
}
